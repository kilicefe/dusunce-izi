# PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Auth.js / NextAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development and CI only. Never enable in production.
ENABLE_TEST_AUTH=false
E2E_TEST_PASSWORD=

# Private Supabase Storage (server-side only; never prefix the key with NEXT_PUBLIC_)
SUPABASE_URL=
# Preferred for new projects (sb_secret_...). Keep server-side only.
SUPABASE_SECRET_KEY=
# Legacy fallback supported through the end of Supabase's 2026 transition.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=pilot-media
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_AUDIO_BYTES=26214400

# Authorizes the durable queue worker endpoint. Use a random value of at least 32 characters.
PROCESSING_WORKER_SECRET=
PROCESSING_JOB_LEASE_SECONDS=300

# Required by the production processing worker.
GEMINI_API_KEY=
